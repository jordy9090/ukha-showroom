# Set to true to show Wearable Line, cart and checkout. Leave empty to hide them.
NEXT_PUBLIC_SHOP_ENABLED=

# Toss Payments 결제위젯 keys (developers.tosspayments.com > API 키).
# Widget keys start with test_gck_/test_gsk_ (test) or live_gck_/live_gsk_ (live).
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Optional: separate secret for encrypting the pending-order cookie.
# Falls back to TOSS_SECRET_KEY when empty.
ORDER_COOKIE_SECRET=

# Optional: email alert for each paid order via Resend (resend.com).
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=
ORDER_FROM_EMAIL=
